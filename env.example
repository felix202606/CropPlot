# Cloudflare Pages secrets. Set with:
#   npx wrangler pages secret put STRIPE_SECRET_KEY --project-name cropplot
# For local function dev, copy this file to .dev.vars (never commit .dev.vars).

# Restricted key (rk_...) with Customers, Checkout, Subscriptions, and Billing Portal.
# Webhook signing secret from the endpoint, and the CropPlot Pro yearly Price id.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
